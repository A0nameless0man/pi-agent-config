#!/usr/bin/env bash
# pre-commit: 排除 provider 切换噪音
#
# 原理:switch-model.sh 只改 settings.json 的 defaultProvider/Model/thinking
# 和 agents/*.md 的 model/thinking 行,不动其他字段(packages/theme 等)。
# 所以提交前切回 git 的 baseline profile 并重新 stage 这几个文件,
# 即可让 commit 不含 provider 切换噪音,同时保留文件里的其他真实变更。
# post-commit 会把 profile 切回用户当前值。
#
# 若要强制提交 provider 变更(如故意改 baseline),用 git commit --no-verify。
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 只在仓库里有 switch-model.sh 时生效
[ -f switch-model.sh ] || exit 0

NOISE_FILES=(settings.json)
shopt -s nullglob
for f in agents/*.md; do NOISE_FILES+=("$f"); done

# 没有任何噪音文件被 stage → 不处理
if ! git diff --cached --name-only -- "${NOISE_FILES[@]}" | grep -q .; then
  exit 0
fi

# baseline = git HEAD 的 settings.json defaultProvider(即 git 里固化的 provider)
BASELINE=$(git show HEAD:settings.json 2>/dev/null | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{process.stdout.write(JSON.parse(s).defaultProvider||"")}catch{}})' 2>/dev/null || true)
if [ -z "$BASELINE" ]; then
  echo "[pi-hook] 无法确定 baseline provider,跳过 provider 标准化" >&2
  exit 0
fi

# 当前工作区 provider
CURRENT=$(node -e 'try{process.stdout.write(require("./settings.json").defaultProvider||"")}catch{}' 2>/dev/null || true)

# 已经是 baseline(无切换噪音)→ 无需处理
if [ -z "$CURRENT" ] || [ "$CURRENT" = "$BASELINE" ]; then
  exit 0
fi

# 切到 baseline;失败则中止提交(工作区不变,switch-model 是原子的)
if ! bash switch-model.sh "$BASELINE" >/dev/null 2>&1; then
  echo "[pi-hook] switch-model 切 baseline($BASELINE)失败,中止提交(请检查 switch-model.sh)" >&2
  # 尝试切回 CURRENT 以保工作区一致
  bash switch-model.sh "$CURRENT" >/dev/null 2>&1 || true
  exit 1
fi

# 重新 stage 噪音文件(现在是 baseline 版本,provider 字段=HEAD 值)
git add -- settings.json agents/*.md 2>/dev/null || true

# 记录原 profile,供 post-commit 恢复
printf '%s' "$CURRENT" > .git/PI_HOOK_PROFILE_BEFORE
echo "[pi-hook] provider 噪音已标准化为 baseline($BASELINE);commit 后自动恢复 $CURRENT" >&2
exit 0
